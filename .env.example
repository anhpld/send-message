# Messenger browser settings
MESSENGER_BASE_URL=https://www.messenger.com/
MESSENGER_STORAGE_STATE=.playwright/messenger-state.json
MESSENGER_DIAGNOSTICS_DIR=.playwright/diagnostics
MESSENGER_TIMEOUT_MS=30000
HEADLESS=false

# Local HTTP API settings
API_HOST=127.0.0.1
API_PORT=3000
API_KEY=replace-with-a-long-random-value

# Public host port used by compose.yaml. Restrict access with the server firewall.
SEND_MESSAGE_PORT=3001
